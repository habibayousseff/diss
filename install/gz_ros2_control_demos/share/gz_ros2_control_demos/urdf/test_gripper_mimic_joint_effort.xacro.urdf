<?xml version="1.0" ?>
<robot name="gripper">
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="violet">
        <color rgba="0.4 0.18 0.57 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.5"/>  <!-- Reduced from 50kg to 0.5kg -->
      <inertia ixx="0.000833" ixy="0.0" ixz="0.0" iyy="0.000521" iyz="0.0" izz="0.000521"/>
    </inertial>
  </link>

  <link name="finger_right">
    <visual>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.04"/>  <!-- Reduced from 4kg to 0.04kg -->
      <inertia ixx="0.00000337" ixy="0.0" ixz="0.0" iyy="0.00000387" iyz="0.0" izz="0.000000567"/>
    </inertial>
  </link>

  <link name="finger_left">
    <visual>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.04"/>
      <inertia ixx="0.00000337" ixy="0.0" ixz="0.0" iyy="0.00000387" iyz="0.0" izz="0.000000567"/>
    </inertial>
  </link>
  <joint name="right_finger_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <origin xyz="0 -0.055 0.1" rpy="0.0 0.0 0.0"/>
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <limit effort="10.0" lower="0" upper="0.02" velocity="0.1"/>
  </joint>
  <joint name="left_finger_joint" type="prismatic">
    <mimic joint="right_finger_joint"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0 0.055 0.1" rpy="0.0 0.0 3.1415926535"/>
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <limit effort="10.0" lower="0" upper="0.02" velocity="0.1"/>
  </joint>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="right_finger_joint">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.15</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="left_finger_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find gz_ros2_control_demos)/config/gripper_controller_effort.yaml</parameters>
    </plugin>
  </gazebo>
</robot>