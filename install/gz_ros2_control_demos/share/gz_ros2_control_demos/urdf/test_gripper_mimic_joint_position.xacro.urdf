<?xml version="1.0" ?>
<robot name="gripper">

  <!-- Gripper Base Link -->
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="violet">
        <color rgba="0.4 0.18 0.57 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.1 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.5"/>
      <inertia ixx="0.000833" ixy="0.0" ixz="0.0"
               iyy="0.000521" iyz="0.0" izz="0.000521"/>
    </inertial>
  </link>

  <!-- Right Finger Link -->
  <link name="finger_right">
    <visual>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.04"/>
      <inertia ixx="0.00000337" ixy="0.0" ixz="0.0"
               iyy="0.00000387" iyz="0.0" izz="0.000000567"/>
    </inertial>
  </link>

  <!-- Left Finger Link -->
  <link name="finger_left">
    <visual>
      <geometry>
        <box size="0.04 0.01 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.04"/>
      <inertia ixx="0.00000337" ixy="0.0" ixz="0.0"
               iyy="0.00000387" iyz="0.0" izz="0.000000567"/>
    </inertial>
  </link>

  <!-- Right Finger Joint -->
  <joint name="right_finger_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <origin xyz="0.0 -0.048 0.1" rpy="0.0 0.0 0.0"/>
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <limit effort="10.0" lower="0" upper="0.086" velocity="0.1" acceleration="0.5"/>
  </joint>

  <!-- Left Finger Joint (stationary) -->
  <joint name="left_finger_joint" type="fixed">
    <origin xyz="0.0 0.048 0.1" rpy="0.0 0.0 3.1415926535"/>
    <parent link="gripper_base"/>
    <child link="finger_left"/>
  </joint>

</robot>
